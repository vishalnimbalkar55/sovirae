{
  "manifest_version": 3,
  "name": "Sovirae",
  "version": "0.1.0",
  "description": "Read selected text or any part of a page aloud with Sovirae's local voices.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sovirae",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Read the selected text"
    },
    "pick-text": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Pick part of the page to read"
    }
  }
}
