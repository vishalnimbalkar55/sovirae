{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sovirae",
  "version": "0.1.0",
  "identifier": "com.sovirae.desktop",
  "build": {
    "beforeDevCommand": "cargo build --release -p speakit-kokoro-worker -p speakit-pocket-worker -p speakit-native-host && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release -p speakit-kokoro-worker -p speakit-pocket-worker -p speakit-native-host && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sovirae",
        "url": "index.html",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      },
      {
        "label": "player",
        "title": "Sovirae player",
        "url": "player.html",
        "width": 520,
        "height": 112,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Local text-to-speech",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": ["../target/release/libwebgpu_dawn.dylib"],
      "files": {
        "MacOS/speakit-kokoro-worker": "../target/release/speakit-kokoro-worker",
        "MacOS/speakit-pocket-worker": "../target/release/speakit-pocket-worker",
        "MacOS/speakit-native-host": "../target/release/speakit-native-host"
      }
    },
    "resources": {
      "../ext/manifest.json": "ext/manifest.json",
      "../ext/sw.js": "ext/sw.js",
      "../ext/content.js": "ext/content.js",
      "../ext/popup.html": "ext/popup.html",
      "../ext/popup.js": "ext/popup.js",
      "../ext/options.html": "ext/options.html",
      "../ext/options.js": "ext/options.js",
      "../ext/ui.css": "ext/ui.css",
      "../ext/lib/*.js": "ext/lib/",
      "../ext/icons/*.png": "ext/icons/"
    }
  }
}