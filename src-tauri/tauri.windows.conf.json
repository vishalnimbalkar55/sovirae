{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "node scripts/prepare-windows.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/prepare-windows.mjs && npm run build"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../target/windows-bundle/": ""
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
